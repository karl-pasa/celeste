APP_NAME=CELESTE
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://celeste.test

APP_LOCALE=en
APP_FAKER_LOCALE=en_PH

# -----------------------------------------------------------------------------
# Database — Supabase (PostgreSQL)
# -----------------------------------------------------------------------------
# Supabase dashboard → Project Settings → Database → Connection string → URI.
# Use the SESSION POOLER connection (port 5432) for Laragon and the
# TRANSACTION POOLER (port 6543) for Vercel, since serverless functions
# open and drop connections constantly.
#
# The password is the database password you set when creating the project —
# not your Supabase account password. If it contains special characters,
# wrap the whole value in quotes.

DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD="your-database-password"
DB_SSLMODE=require

# Supabase project details (used only if you add Storage or Auth later)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# CELESTE
# -----------------------------------------------------------------------------
CELESTE_INSTITUTION="Partido State University"
CELESTE_INSTITUTION_SHORT="Partido State University"
CELESTE_CAMPUS="Camarines Sur"
CELESTE_REGISTRAR_EMAIL=registrar@parsu.edu.ph

CELESTE_REGISTRAR_NAME="MA. TERESA L. OCAMPO, Ph.D."
CELESTE_PRESIDENT_NAME="THE UNIVERSITY PRESIDENT"
CELESTE_RECORDS_OFFICER="RECORDS OFFICER"

# Server-side key mixed into every certificate fingerprint.
# Generate one with: php artisan celeste:pepper
# Set it ONCE. Changing it later invalidates every certificate already issued.
CELESTE_HASH_PEPPER=

# Decision support thresholds
CELESTE_FAILURE_THRESHOLD=0.15
CELESTE_SPREAD_THRESHOLD=12

# -----------------------------------------------------------------------------
# Hashing — bcrypt
# -----------------------------------------------------------------------------
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Sessions, cache, queue
# -----------------------------------------------------------------------------
# On Vercel the filesystem is read-only apart from /tmp, so sessions and cache
# must live in the database there. Locally, file is fine and faster.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local

LOG_CHANNEL=stack
LOG_LEVEL=debug

MAIL_MAILER=log
MAIL_FROM_ADDRESS="registrar@parsu.edu.ph"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
